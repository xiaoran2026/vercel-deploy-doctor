// Prisma Schema for Vercel Deploy Doctor
// Run: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  deletedAt     DateTime?

  subscription  Subscription?
  checks        Check[]
  reports       Report[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Subscription {
  id             String    @id @default(uuid())
  userId         String    @unique
  plan           Plan      @default(FREE)
  stripeCustomerId String?
  stripeSubscriptionId String?
  status         SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  checksUsedThisMonth Int   @default(0)
  lastResetAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum Plan {
  FREE
  STARTER
  GROWTH
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

model Check {
  id             String    @id @default(uuid())
  userId         String
  targetUrl      String    // The Vercel app URL to check (e.g. my-app.vercel.app)
  status         CheckStatus @default(QUEUED)
  progress       Int       @default(0)
  currentStep    String?
  errorMessage   String?

  // Check options
  includeLighthouse Boolean  @default(true)
  includeSecurity   Boolean  @default(true)
  includePerformance Boolean  @default(true)
  includeConfig     Boolean  @default(true)

  // Timestamps
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  report         Report?

  @@index([userId, createdAt])
  @@map("checks")
}

enum CheckStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Report {
  id             String    @id @default(uuid())
  userId         String
  checkId        String    @unique
  targetUrl      String

  // Overall scores
  overallScore   Int       // 0-100 weighted score
  deployHealth   Int       // 0-100 deploy config health
  performanceScore Int?    // 0-100 Lighthouse performance
  accessibilityScore Int?  // 0-100 Lighthouse a11y
  seoScore       Int?      // 0-100 Lighthouse SEO
  securityScore  Int?      // 0-100 security checks

  // Summary
  summary        String?   // JSON string: { issuesCount, warningsCount, passedCount, topIssues }
  lighthouseData String?   // JSON snapshot of Lighthouse results
  findingsData   String?   // JSON array of all findings
  deployChecks   String?   // JSON: vercel.json config, headers, caching, CORS, env, build settings

  status         ReportStatus @default(GENERATING)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  check          Check     @relation(fields: [checkId], references: [id], onDelete: Cascade)
  findings       Finding[]

  @@index([userId, createdAt])
  @@map("reports")
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

model Finding {
  id             String    @id @default(uuid())
  reportId       String
  category       FindingCategory // DEPLOY | PERFORMANCE | ACCESSIBILITY | SEO | SECURITY | CONFIG
  severity       Severity  // CRITICAL | WARNING | INFO | PASS
  title          String
  description    String?
  recommendation String?   // How to fix it
  ruleId         String?   // e.g. "vercel-no-cache-header", "lh-unminified-css"
  impact         String?   // "High" / "Medium" / "Low"
  docsUrl        String?   // Link to relevant docs
  meta           String?   // JSON extra data (element references, values, etc.)

  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, category, severity])
  @@map("findings")
}

enum FindingCategory {
  DEPLOY
  PERFORMANCE
  ACCESSIBILITY
  SEO
  SECURITY
  CONFIG
}

enum Severity {
  CRITICAL
  WARNING
  INFO
  PASS
}
